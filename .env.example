VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Admin SDK scripts only. Point this at a service-account JSON file; do
# not expose it in browser variables or commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VITE_FIREBASE_USE_EMULATOR=0

# Jamo SVG target renderer: 1 = on. In dev, localStorage "jamozy:jamo-svg-renderer" = "1"/"0" overrides.
VITE_JAMO_SVG_RENDERER=
