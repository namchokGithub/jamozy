{
  "name": "jamozy",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env BROWSER=\"Google Chrome\" vite --open",
    "build": "pnpm content:export-home && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --project jamozy-rules-test --only firestore \"vitest run firestore.rules.test.ts src/infrastructure/firebase/repositories/firebase-admin-content-repository.emulator.test.ts src/infrastructure/firebase/repositories/firebase-session-submission-repository.emulator.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx scripts/seed-firestore.ts",
    "content:export-home": "tsx scripts/export-home-content.ts",
    "admin:grant": "tsx scripts/set-admin-claim.ts",
    "content:migrate-status": "tsx scripts/migrate-content-status.ts",
    "content:backfill-counts": "tsx scripts/backfill-content-counts.ts",
    "jamo-svg:seed": "tsx scripts/generate-jamo-svg-tagger-data.ts",
    "jamo-svg:migrate-reviews": "tsx scripts/migrate-jamo-svg-reviews.ts",
    "jamo-svg:migrate-step-algorithm": "tsx scripts/migrate-jamo-svg-step-algorithm.ts",
    "jamo-svg:enqueue": "tsx scripts/enqueue-jamo-svg.ts",
    "jamo-svg:propose": "tsx scripts/propose-jamo-svg-reviews.ts",
    "jamo-svg:audit": "tsx scripts/audit-jamo-svg-reviews.ts",
    "jamo-svg:compile-runtime": "tsx scripts/compile-jamo-svg-runtime.ts"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
