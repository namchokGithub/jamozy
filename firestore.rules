rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isPublishedCourse(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published';
    }

    function isPublishedUnit(unitId) {
      return get(/databases/$(database)/documents/units/$(unitId)).data.status == 'published';
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin();
      // Content is retired by archiving, never hard-deleted (DEC-034).
      allow delete: if false;
    }

    match /units/{unitId} {
      allow read: if isAdmin() || (
        resource.data.status == 'published' &&
        isPublishedCourse(resource.data.courseId)
      );
      allow create, update: if isAdmin();
      // Content is retired by archiving, never hard-deleted (DEC-034).
      allow delete: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || (
        resource.data.status == 'published' &&
        isPublishedUnit(resource.data.unitId) &&
        isPublishedCourse(get(/databases/$(database)/documents/units/$(resource.data.unitId)).data.courseId)
      );
      allow create, update: if isAdmin();
      // Content is retired by archiving, never hard-deleted (DEC-034).
      allow delete: if false;
    }

    // Per-user data. Only the owning user may read or write their own doc
    // and subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /lessonProgress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /reviewItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /learningSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sessionOutcomes/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /dailyStats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /monthlyStats/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /migrations/{guestId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
