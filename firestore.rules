rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Learning content is public read-only. There is no client write rule, so
    // course content must be administered outside this browser application.
    // See DEC-015 for the retired MVP client-write exception.
    match /courses/{courseId} {
      allow read: if true;
    }

    match /units/{unitId} {
      allow read: if true;
    }

    match /lessons/{lessonId} {
      allow read: if true;
    }

    // Per-user data. Only the owning user may read or write their own doc
    // and subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /lessonProgress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /reviewItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /learningSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sessionOutcomes/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /migrations/{guestId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
